#!/bin/sh
cd "$(git rev-parse --show-toplevel)"

if [ -x ".venv/bin/python.exe" ]; then
  .venv/bin/python.exe release_check.py
elif [ -x ".venv/bin/python3.exe" ]; then
  .venv/bin/python3.exe release_check.py
elif command -v python >/dev/null 2>&1; then
  python release_check.py
elif command -v python3 >/dev/null 2>&1; then
  python3 release_check.py
elif command -v py >/dev/null 2>&1; then
  py -3 release_check.py
else
  echo "release_check.py requires Python"
  exit 1
fi
